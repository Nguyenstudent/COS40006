<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <!-- One component per file, so each DLL can be serviced (patched) independently.
         Component GUIDs are generated automatically by WiX from the file path. -->
    <ComponentGroup Id="AppComponents" Directory="INSTALLFOLDER">

      <!-- The executable (apphost) and the main application assembly.
           The Start menu shortcut is ADVERTISED and lives in the same component as the exe:
           - separate shortcut component          -> warning WIX1076 / ICE69
           - non-advertised shortcut in this comp -> errors ICE43 + ICE57 -->
      <Component>
        <File Id="GradeTrackerExe" Source="$(var.AppPublishDir)GradeTracker.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut"
                    Directory="AppMenuFolder"
                    Advertise="yes"
                    Icon="AppIcon.ico"
                    Name="!(bind.Property.ProductName)"
                    Description="Track unit marks, WAM and GPA"
                    WorkingDirectory="INSTALLFOLDER" />
        </File>
        <RemoveFolder Id="RemoveAppMenuFolder" Directory="AppMenuFolder" On="uninstall" />
      </Component>
      <Component>
        <File Source="$(var.AppPublishDir)GradeTracker.dll" />
      </Component>

      <!-- .NET host files: tell the host which runtime version and which DLLs to load -->
      <Component>
        <File Source="$(var.AppPublishDir)GradeTracker.runtimeconfig.json" />
      </Component>
      <Component>
        <File Source="$(var.AppPublishDir)GradeTracker.deps.json" />
      </Component>

      <!-- Our own class libraries -->
      <Component>
        <File Source="$(var.AppPublishDir)GradeTracker.Core.dll" />
      </Component>
      <Component>
        <File Source="$(var.AppPublishDir)GradeTracker.Data.dll" />
      </Component>

      <!-- Third-party dependency from NuGet -->
      <Component>
        <File Source="$(var.AppPublishDir)Newtonsoft.Json.dll" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
